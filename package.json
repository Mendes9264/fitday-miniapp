{
  "name": "fitday-miniapp-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "个人训练与饮食记录小程序原型",
  "scripts": {
    "start": "node web/server.js",
    "start:lan": "node web/server.js --lan",
    "test": "node --test tests/*.test.js",
    "sync:core": "node scripts/sync-core.js",
    "build:android-web": "node scripts/build-android-web.js",
    "android:sync": "npm run build:android-web && cap sync android",
    "android:apk": "node scripts/build-apk.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
