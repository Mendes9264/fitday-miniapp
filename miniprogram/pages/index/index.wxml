<view class="app">
  <view class="topbar"><image class="mark" src="../../assets/logo.png" mode="aspectFit"></image><view><text class="brand">练食</text><text class="tagline">练得明白，吃得有数</text></view><text class="settings" data-tab="profile" bindtap="tab">设置</text></view>
  <view class="content">
    <view wx:if="{{tab === 'home'}}">
      <view class="heading"><text class="title">今天，练得怎样？</text><text class="subtitle">用几分钟补记训练和饮食，慢慢看清自己的节奏。</text></view>
      <view class="hero"><text class="hero-label">今日饮食 · {{today.unknownCount ? '仅已识别部分' : '粗略估算'}}</text><text class="hero-title" wx:if="{{today.estimatedCount}}">{{today.range.min}}–{{today.range.max}} 千卡</text><text class="hero-title" wx:elif="{{today.meals.length}}">已记录，待估算</text><text class="hero-title" wx:else="">从第一餐开始</text><view class="hero-stats"><view><text>{{today.meals.length}}</text><text>餐已记录</text></view><view><text>{{today.workouts.length}}</text><text>次训练</text></view></view><text class="hero-foot" wx:if="{{reference}}">每日参考 {{reference.min}}–{{reference.max}} 千卡。估算有误差。</text><text class="hero-foot" wx:else="">需要个人每日参考时，可在设置中填写基础资料。</text></view>
      <view class="quick"><view data-tab="workout" bindtap="tab"><text class="quick-icon">↗</text><text class="quick-title">补记训练</text><text class="quick-sub">下一次 · {{nextPlan.name}} / {{nextPlan.focus}}</text></view><view class="warm" data-tab="meal" bindtap="tab"><text class="quick-icon">＋</text><text class="quick-title">记一餐</text><text class="quick-sub">文字或照片，估个范围</text></view></view>
      <view class="section-title">今天的记录</view><view class="card empty" wx:if="{{emptyToday}}">还没有记录。先从最容易补记的一项开始。</view><view class="card" wx:for="{{today.workouts}}" wx:key="id"><text class="card-title">力量训练 · {{item.planName}}</text><text class="card-sub">{{item.exercises.length}} 个动作</text></view><view class="card" wx:for="{{today.meals}}" wx:key="id"><text class="card-title">{{item.type}} · {{item.text}}</text><text class="card-sub">{{item.items.length}} 种食物</text></view>
      <view class="section-title">接下来</view><view class="card tinted"><text class="card-title">{{nextPlan.name}} · {{nextPlan.focus}}</text><text class="card-sub">沿用四天训练模板，完成后可一次补记。</text></view>
      <text class="note">家常菜按示例食材和做法估算；未识别的菜不计入数字。照片只留档，暂不自动识别。</text>
    </view>

    <view wx:if="{{tab === 'workout'}}">
      <view class="heading"><text class="title">训练补记</text><text class="subtitle">整场练完后，记下动作、组数、次数和重量。</text></view>
      <view class="record-date"><text class="label">训练日期</text><picker mode="date" value="{{workoutDate}}" end="{{maxRecordDate}}" bindchange="workoutDateChange"><view class="field">{{workoutDate}} ▾</view></picker></view>
      <scroll-view class="rail" scroll-x="true"><view class="rail-inner"><text wx:for="{{state.plan}}" wx:key="id" class="pill {{selectedPlan === index ? 'active' : ''}}" data-index="{{index}}" bindtap="plan">{{item.name}} · {{item.focus}}</text></view></scroll-view>
      <view class="sheet" wx:if="{{editingPlan}}"><text class="sheet-title">编辑训练模板</text><text class="label">名称</text><input class="field" value="{{currentPlan.name}}" data-field="name" bindinput="planField"/><text class="label">训练部位</text><input class="field" value="{{currentPlan.focus}}" data-field="focus" bindinput="planField"/><view wx:for="{{currentPlan.exercises}}" wx:key="id"><text class="label">动作 {{index + 1}}</text><view class="two-fields"><input class="field" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="exerciseField"/><input class="field small-field" type="number" value="{{item.sets}}" data-index="{{index}}" data-field="sets" bindinput="exerciseField"/></view></view><button class="secondary" bindtap="addExercise">＋ 添加动作</button><button class="primary" bindtap="savePlan">保存模板</button></view>
      <view wx:else=""><view class="sheet"><view class="sheet-head"><text class="sheet-title">{{currentPlan.name}} · {{currentPlan.focus}}</text><text class="sheet-sub">{{currentPlan.exercises.length}} 个动作</text></view><view class="exercise" wx:for="{{workoutDraft}}" wx:for-item="exercise" wx:for-index="ei" wx:key="id"><text class="exercise-name">{{exercise.name}}</text><view class="set-row" wx:for="{{exercise.sets}}" wx:for-item="set" wx:for-index="si" wx:key="index"><text class="set-no">{{si + 1}}</text><input class="set-input" type="number" value="{{set.reps}}" data-exercise="{{ei}}" data-set="{{si}}" data-field="reps" bindinput="setField" placeholder="次数"/><input class="set-input" type="digit" value="{{set.weight}}" data-exercise="{{ei}}" data-set="{{si}}" data-field="weight" bindinput="setField" placeholder="重量 kg"/><switch class="set-switch" checked="{{set.done}}" color="#25446A" data-exercise="{{ei}}" data-set="{{si}}" data-field="done" bindchange="setField"/></view></view></view><text class="note">未完成的组可关掉开关。重量可留空；记录只保存在本机。</text><button class="primary" bindtap="saveWorkout">保存训练</button><button class="link" bindtap="editPlan">编辑四天模板</button></view>
    </view>

    <view wx:if="{{tab === 'meal'}}">
      <view class="heading"><text class="title">记一餐</text><text class="subtitle">拍照留档，或直接写吃了什么；份量可以再改。</text></view>
      <view class="record-date"><text class="label">用餐日期</text><picker mode="date" value="{{mealDate}}" end="{{maxRecordDate}}" bindchange="mealDateChange"><view class="field">{{mealDate}} ▾</view></picker></view>
      <scroll-view class="rail" scroll-x="true"><view class="rail-inner"><text wx:for="{{mealTypes}}" wx:key="*this" class="pill {{mealType === item ? 'active' : ''}}" data-type="{{item}}" bindtap="mealType">{{item}}</text></view></scroll-view>
      <view class="sheet"><view class="photo" bindtap="choosePhoto"><image wx:if="{{mealPhoto}}" src="{{mealPhoto}}" mode="aspectFill"/><view wx:else=""><text>＋ 添加餐食照片</text><text class="tiny">照片仅保存在本机，暂不自动识别</text></view></view><text class="label">这餐吃了什么</text><textarea class="field textarea" value="{{mealText}}" bindinput="mealText" placeholder="例：一盘西红柿炒鸡蛋、毛豆烧鸡、一碗米饭"/><button class="secondary" bindtap="parseMeal">拆解菜名并估算</button></view>
      <view class="section-title">菜品与份量</view><view class="card"><text class="empty" wx:if="{{!mealItems.length}}">输入菜名后点上方按钮，或从下方手动添加。</text><view class="food-row" wx:for="{{mealItems}}" wx:key="listIndex"><view class="food-desc"><text class="food-name">{{item.name}}</text><text class="food-detail">{{item.detail}}</text><text class="food-recipe" wx:if="{{item.recipe}}">{{item.recipe}}</text><text class="food-recipe" wx:if="{{item.assumptions}}">假设：{{item.assumptions}}</text></view><input class="field gram" type="number" value="{{item.grams}}" data-index="{{index}}" bindchange="itemGrams"/><text class="unit">克</text><text class="remove" data-index="{{index}}" bindtap="removeFood">×</text></view><view class="food-add"><picker range="{{foods}}" range-key="name" value="{{foodIndex}}" bindchange="foodSelect"><view class="field">{{foods[foodIndex].name}} ▾</view></picker><input class="field gram" type="number" value="{{foodGrams}}" bindinput="foodGrams" placeholder="克数"/><button class="secondary" bindtap="addFood">添加</button></view></view>
      <view wx:if="{{mealItems.length}}"><view class="estimate" wx:if="{{mealEstimate.estimatedCount}}"><text class="estimate-label">{{mealEstimate.unknownCount ? '已识别部分热量' : '本餐热量'}} · 约</text><text class="estimate-number">{{mealEstimate.range.min}}–{{mealEstimate.range.max}} 千卡</text><view class="macros"><view><text>{{mealEstimate.totals.protein}}g</text><text>蛋白质</text></view><view><text>{{mealEstimate.totals.carbs}}g</text><text>碳水</text></view><view><text>{{mealEstimate.totals.fat}}g</text><text>脂肪</text></view></view></view><view class="card empty" wx:else="">已保存菜名，但缺少可靠的食材信息，暂不显示热量。</view><view class="advice"><text class="card-title">{{advice.headline}}</text><text wx:for="{{advice.notes}}" wx:key="*this">· {{item}}</text></view></view>
      <text class="note">未知菜名暂不计入热量；可手动添加食材。家常菜按示例食材和用油估算；建议仍是规则提示。</text><button class="primary" bindtap="saveMeal">保存这餐</button>
    </view>

    <view wx:if="{{tab === 'history'}}"><view class="heading"><text class="title">我的记录</text><text class="subtitle">训练和饮食都在这里，按天回看。</text></view><view class="card empty" wx:if="{{!entries.length}}">还没有记录。完成训练或记一餐后就会出现在这里。</view><view class="history-row" wx:for="{{entries}}" wx:key="id"><text class="history-mark {{item.kind === 'meal' ? 'food-mark' : ''}}">{{item.kind === 'meal' ? '餐' : '练'}}</text><view class="history-info"><text class="card-title">{{item.label}}</text><text class="card-sub">{{item.date}} · {{item.detail}}</text></view><text class="remove" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="deleteEntry">删除</text></view></view>

    <view wx:if="{{tab === 'profile'}}"><view class="heading"><text class="title">个人设置</text><text class="subtitle">基础资料只填一次，随时可以调整。</text></view><view class="reference"><text>每日摄入参考</text><text class="reference-number" wx:if="{{reference}}">{{reference.min}}–{{reference.max}} 千卡</text><text class="reference-number" wx:else="">尚未设置</text><text>用于对照已记录的全天饮食；估算有误差。</text></view><view class="sheet"><text class="label">年龄</text><input class="field" type="number" value="{{state.profile.age}}" data-field="age" bindinput="profileField"/><text class="label">身高 cm</text><input class="field" type="number" value="{{state.profile.heightCm}}" data-field="heightCm" bindinput="profileField"/><text class="label">当前体重 kg</text><input class="field" type="digit" value="{{state.profile.weightKg}}" data-field="weightKg" bindinput="profileField"/><text class="label">公式参数</text><picker range="{{formulaLabels}}" value="{{formulaIndex}}" bindchange="formulaChange"><view class="field">{{formulaLabels[formulaIndex]}} ▾</view></picker><text class="label">日常活动量</text><picker range="{{activityLabels}}" value="{{activityIndex}}" bindchange="activityChange"><view class="field">{{activityLabels[activityIndex]}} ▾</view></picker><text class="label">自行设置每日参考千卡（可选，优先使用）</text><input class="field" type="number" value="{{state.profile.dailyReference}}" data-field="dailyReference" bindinput="profileField" placeholder="留空则粗估"/><button class="primary" bindtap="saveProfile">保存设置</button></view><text class="note">初始体重只用于一次性估算，不生成体重趋势。公式仅提供粗略起点。</text></view>
  </view>
  <view class="nav"><view data-tab="home" bindtap="tab" class="{{tab === 'home' ? 'selected' : ''}}"><text>⌂</text><text>今天</text></view><view data-tab="workout" bindtap="tab" class="{{tab === 'workout' ? 'selected' : ''}}"><text>▣</text><text>训练</text></view><view data-tab="meal" bindtap="tab" class="{{tab === 'meal' ? 'selected' : ''}}"><text>◯</text><text>记一餐</text></view><view data-tab="history" bindtap="tab" class="{{tab === 'history' ? 'selected' : ''}}"><text>▤</text><text>记录</text></view></view>
</view>
