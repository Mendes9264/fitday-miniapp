.app { min-height:100vh; background:#F3F5F8; }
.topbar { height:110rpx; padding:0 32rpx; background:#E9EFF7; display:flex; align-items:center; gap:18rpx; }
.mark { width:72rpx; height:72rpx; flex:none; border-radius:20rpx; }
.brand { display:block; font-weight:700; letter-spacing:3rpx; font-size:34rpx; line-height:1.15; }
.tagline { display:block; color:#5F6D7E; font-size:18rpx; }
.settings { margin-left:auto; color:#25446A; font-size:23rpx; border:1rpx solid #BBC9D9; border-radius:30rpx; padding:8rpx 20rpx; }
.content { padding:0 28rpx 154rpx; }
.heading { padding:30rpx 4rpx 28rpx; }
.title { display:block; font-size:46rpx; font-weight:700; letter-spacing:-1rpx; }
.subtitle { display:block; color:#5F6D7E; font-size:23rpx; line-height:1.6; margin-top:8rpx; }
.hero { background:#172B46; color:#fff; border-radius:42rpx 42rpx 16rpx 42rpx; padding:40rpx 36rpx 30rpx; }
.hero-label { display:block; color:#C9D8E9; font-size:23rpx; }
.hero-title { display:block; font-size:54rpx; font-weight:700; margin:18rpx 0 24rpx; }
.hero-stats { display:flex; gap:52rpx; }
.hero-stats view text { display:block; }.hero-stats view text:first-child { font-size:44rpx; font-weight:700; }.hero-stats view text:last-child { font-size:20rpx; color:#D7E2EF; }
.hero-foot { display:block; border-top:1rpx solid rgba(255,255,255,.2); color:#DDE7F2; font-size:20rpx; line-height:1.6; margin-top:24rpx; padding-top:19rpx; }
.quick { display:flex; gap:18rpx; margin:24rpx 0 42rpx; }.quick view { flex:1; min-width:0; min-height:152rpx; background:#fff; border-radius:28rpx; padding:22rpx; }.quick view.warm { background:#FFF3DC; }
.quick text { display:block; }.quick-icon { color:#25446A; font-size:42rpx; line-height:1; }.quick .warm .quick-icon { color:#845718; }.quick-title { font-size:27rpx; font-weight:700; margin-top:13rpx; }.quick-sub { color:#5F6D7E; font-size:20rpx; margin-top:4rpx; }
.section-title { font-size:29rpx; font-weight:700; margin:33rpx 2rpx 16rpx; }.card { background:#fff; border-radius:28rpx; padding:26rpx; margin-bottom:14rpx; }.tinted { background:#E9EFF7; }.card-title { display:block; font-size:27rpx; font-weight:650; }.card-sub { display:block; color:#5F6D7E; font-size:21rpx; margin-top:7rpx; }.empty { color:#5F6D7E; font-size:22rpx; line-height:1.6; }
.note { display:block; color:#5F6D7E; font-size:20rpx; line-height:1.7; margin:20rpx 4rpx; }
.rail { white-space:nowrap; width:100%; }.rail-inner { display:flex; gap:12rpx; padding-bottom:10rpx; }.pill { flex:none; border:1rpx solid #DCE3EC; background:#fff; color:#5F6D7E; border-radius:40rpx; padding:14rpx 22rpx; font-size:23rpx; }.pill.active { color:#fff; background:#25446A; border-color:#25446A; }
.sheet { background:#fff; border-radius:32rpx; padding:30rpx; margin-top:20rpx; }.sheet-head { display:flex; justify-content:space-between; align-items:baseline; border-bottom:1rpx solid #DCE3EC; padding-bottom:20rpx; }.sheet-title { display:block; font-size:32rpx; font-weight:700; }.sheet-sub { color:#5F6D7E; font-size:20rpx; }
.exercise { border-bottom:1rpx solid #DCE3EC; padding:24rpx 0; }.exercise:last-child { border:0; }.exercise-name { display:block; font-size:27rpx; font-weight:650; margin-bottom:12rpx; }.set-row { display:flex; gap:12rpx; align-items:center; margin:10rpx 0; }.set-no { width:30rpx; color:#5F6D7E; font-size:21rpx; }.set-input { flex:1; min-width:0; background:#F7F9FC; border:1rpx solid #DCE5F0; border-radius:14rpx; padding:13rpx; font-size:23rpx; }.set-switch { transform:scale(.68); transform-origin:center right; width:80rpx; }
.field { box-sizing:border-box; width:100%; border:1rpx solid #DCE3EC; background:#F8FAFD; border-radius:16rpx; min-height:76rpx; padding:14rpx 20rpx; font-size:25rpx; color:#1B2940; }.label { display:block; color:#5F6D7E; font-size:22rpx; margin:25rpx 0 10rpx; }.two-fields { display:flex; gap:12rpx; }.small-field { width:125rpx; flex:none; }.textarea { min-height:160rpx; width:100%; }
.primary { background:#25446A; color:#fff; font-size:27rpx; font-weight:650; margin:22rpx 0 0; padding:10rpx; }.secondary { color:#25446A; background:#fff; border:1rpx solid #BCCAD9; font-size:23rpx; margin:18rpx 0 0; padding:5rpx 12rpx; }.link { color:#25446A; background:transparent; font-size:23rpx; margin:4rpx 0; }
.photo { border:2rpx dashed #A9BED6; background:#F4F7FB; color:#25446A; border-radius:22rpx; min-height:155rpx; display:flex; justify-content:center; align-items:center; text-align:center; overflow:hidden; }.photo text { display:block; }.photo .tiny { color:#5F6D7E; font-size:19rpx; margin-top:7rpx; }.photo image { width:100%; height:240rpx; }
.food-row { display:flex; align-items:center; gap:10rpx; border-bottom:1rpx solid #DCE3EC; padding:12rpx 0; font-size:25rpx; }.food-row text:first-child { flex:1; }.gram { width:140rpx; min-height:65rpx; }.unit { color:#5F6D7E; font-size:21rpx; }.remove { color:#A44343; font-size:22rpx; padding:12rpx; }.food-add { display:flex; gap:10rpx; align-items:center; margin-top:17rpx; }.food-add picker { flex:1; min-width:0; }.food-add button { margin:0; flex:none; }
.food-desc { flex:1; min-width:0; }.food-desc text { display:block; }.food-desc .food-name { font-weight:650; }.food-desc .food-detail { color:#5F6D7E; font-size:20rpx; margin-top:5rpx; }.food-desc .food-recipe { color:#5F6D7E; font-size:18rpx; line-height:1.45; margin-top:4rpx; }
.estimate { background:#E9EFF7; border-radius:28rpx; padding:27rpx; margin-top:24rpx; }.estimate-label { display:block; color:#25446A; font-size:21rpx; }.estimate-number { display:block; font-size:43rpx; font-weight:700; margin:8rpx 0 17rpx; }.macros { display:flex; gap:14rpx; }.macros view { flex:1; border-top:1rpx solid #C4D2E3; padding-top:13rpx; }.macros text { display:block; }.macros text:first-child { font-size:26rpx; font-weight:700; }.macros text:last-child { font-size:19rpx; color:#5F6D7E; }
.advice { border-left:5rpx solid #D69B38; margin:24rpx 0; padding:4rpx 0 4rpx 21rpx; }.advice text { display:block; color:#5F6D7E; font-size:22rpx; line-height:1.6; margin-top:7rpx; }.advice .card-title { color:#1B2940; }
.history-row { display:flex; align-items:center; gap:18rpx; background:#fff; border-radius:24rpx; padding:18rpx; margin-bottom:12rpx; }.history-mark { width:54rpx; height:54rpx; background:#E9EFF7; border-radius:15rpx; color:#25446A; display:flex; justify-content:center; align-items:center; }.food-mark { background:#FFF3DC; color:#845718; }.history-info { flex:1; min-width:0; }.history-info .card-title { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.reference { background:#172B46; color:#fff; border-radius:28rpx; padding:28rpx; }.reference text { display:block; font-size:21rpx; color:#C9D8E9; line-height:1.6; }.reference .reference-number { color:#fff; font-size:39rpx; font-weight:700; margin:9rpx 0; }
.nav { position:fixed; bottom:0; left:0; right:0; height:110rpx; padding-bottom:env(safe-area-inset-bottom); background:rgba(255,255,255,.97); border-top:1rpx solid #DCE3EC; display:flex; z-index:5; }.nav view { flex:1; display:flex; flex-direction:column; justify-content:center; align-items:center; color:#5F6D7E; font-size:19rpx; }.nav view text:first-child { font-size:36rpx; line-height:1.1; }.nav view.selected { color:#25446A; font-weight:700; }
.record-date { max-width:430rpx; margin:0 0 20rpx; }
.record-date .label { margin:0 0 10rpx; }
